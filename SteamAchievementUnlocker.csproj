<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Version>2.0.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Steamworks.NET" Version="20.2.0" />
    <Compile Remove="tests\**\*.cs" />
    <None Include="lib\steam_api64.dll" Link="lib\steam_api64.dll" ExcludeFromSingleFile="true" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <Target Name="RequireSteamDll" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('lib\steam_api64.dll')" Text="Missing lib/steam_api64.dll. Use the Windows-x64 DLL from Steamworks.NET Standalone 20.2.0 (SDK 1.57)." />
  </Target>
</Project>
